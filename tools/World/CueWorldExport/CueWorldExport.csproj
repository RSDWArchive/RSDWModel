<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Cue4ParseRoot Condition="'$(Cue4ParseRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\CUE4Parse</Cue4ParseRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Cue4ParseRoot)\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="$(Cue4ParseRoot)\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>
</Project>
